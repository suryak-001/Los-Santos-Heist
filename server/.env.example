# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to Git!

# Admin Password - Change this to a secure password
ADMIN_PASSWORD=change_me_to_secure_password

# Server Port (optional, defaults to 3000)
PORT=3000

# Database URL. Local development uses a Homebrew Postgres database:
#   createdb ttbm_dev && npx prisma db push
# Production (Railway) sets its own DATABASE_URL.
DATABASE_URL=postgresql://YOUR_MAC_USER@localhost:5432/ttbm_dev

# Rule tests (npm test) create games, so point them at a separate database
# and save file, e.g.:
#   createdb ttbm_test
#   DATABASE_URL=postgresql://YOUR_MAC_USER@localhost:5432/ttbm_test npx prisma db push
#   GAME_STATE_PATH=/tmp/ttbm_test_state.json DATABASE_URL=...ttbm_test npm test
